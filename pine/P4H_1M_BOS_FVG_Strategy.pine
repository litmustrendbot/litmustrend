//@version=5
strategy("P4H 1M BOS + FVG Strategy", shorttitle="P4H 1M BOS+FVG", overlay=true, initial_capital=1000, default_qty_type=strategy.cash, default_qty_value=10, currency=currency.USD, max_boxes_count=500, max_lines_count=500, max_labels_count=500, pyramiding=50)

// ==============================================================================
//  STRATEGY SUMMARY
//  - Higher Timeframe Bias: 4-Hour (4H / 240) Previous 4H Close (P4HC)
//  - Execution Timeframe  : 1-Minute (1M) Internal Swing BOS + FVG Retracement
//  - Risk Management      : 1% Risk per trade, Stepped Trailing Stop (9.5R - 9.9R),
//                           10R Target, 4H Circuit Breaker (3 Consecutive Losses)
// ==============================================================================

// ==========================================
// 1. INPUT SETTINGS
// ==========================================
var string G_RISK  = "Risk and Position Sizing"
var string G_BIAS  = "Higher Timeframe Bias (4H)"
var string G_BOS   = "1M Market Structure / BOS"
var string G_ENTRY = "Zone and Entry Refinement"
var string G_VIS   = "Visuals and Display"

// Risk settings
riskUsd           = input.float(10.0, "Risk per Trade ($)", group=G_RISK, tooltip="Exact dollar amount to risk per trade. Position size is calculated automatically based on the stop loss distance.")
riskPercent       = input.float(1.0, "Risk Percent per Trade (%) [If not fixed USD]", group=G_RISK, tooltip="Percentage of current equity to risk per trade if using percent mode.")
useFixedUsd       = input.bool(true, "Use Fixed USD Risk ($10)", group=G_RISK, tooltip="When enabled, risks exact dollar amount (e.g. $10) instead of account percentage.")
tp_R              = input.float(10.0, "Final Take Profit (R)", group=G_RISK, tooltip="Target R:R multiple for full take profit.")
enableStepped     = input.bool(true, "Enable Stepped Trailing (9.5R - 9.9R)", group=G_RISK, tooltip="Trail stop loss incrementally once profit reaches 9.5R, 9.6R, 9.7R, 9.8R, and 9.9R.")
maxConsecLossDay  = input.int(0, "Max Consecutive Losses Per Day (0 = Disabled)", minval=0, maxval=10, group=G_RISK, tooltip="If the strategy encounters this many losses in a row within the same day, trading is paused until the next day. Set to 0 to disable.")
maxConsecLoss4H   = input.int(3, "Max Consecutive Losses Per 4H (Pause until next 4H candle)", minval=0, maxval=10, group=G_RISK, tooltip="If the strategy encounters this many losses in a row within the same 4-hour window, trading is paused until the next 4H candle forms. Set to 0 to disable.")
onlyOneTrade      = input.bool(true, "Do Not Open Another Trade While Running", group=G_RISK, tooltip="Strictly prevents opening or registering any new trade while a position is already open. When a fresh BOS appears while a limit order is waiting, replaces the waiting order.")
maxTradesPerDay   = input.int(0, "Max Trades Per Day (0 = Unlimited)", minval=0, maxval=20, group=G_RISK, tooltip="Limit maximum total trades taken in a single day. Set to 1 for Max 1 Trade/Day, or 0 for unlimited.")

// 4H Bias settings (replaces Daily PDC with 4-Hour P4HC)
useHtfFilter      = input.bool(true, "Filter Trades by Previous 4H Close", group=G_BIAS, tooltip="Only take Longs when 1M close is above Previous 4H Close, and Shorts when below.")
htfTimeframe      = input.timeframe("240", "Higher Timeframe (HTF)", group=G_BIAS, tooltip="Higher timeframe used for directional bias filter. Default is 240 (4 Hours).")
p4hColor          = input.color(color.black, "Previous 4H Close Line Color (2x thick)", group=G_BIAS)

// 1M BOS settings
pivotLookback     = input.int(3, "Internal Pivot Lookback", minval=1, maxval=20, group=G_BOS, tooltip="Bars left and right to detect internal swing highs/lows on the 1M chart.")
confirmCloseWick  = input.bool(true, "BOS Candle Close Beyond Initiating Wick", group=G_BOS, tooltip="Requires BOS candle close beyond the initiating candle extreme.")
bosColor          = input.color(color.black, "BOS Line Color (1x thick)", group=G_BOS)

// Entry and Zone settings
useFvgRefine      = input.bool(true, "Use FVG Entry Refinement", group=G_ENTRY, tooltip="If an FVG forms after the origin candle, refine entry to the FVG edge.")
maxBarsWait       = input.int(25, "Max Bars to Wait for Retracement (1M Bars)", minval=1, maxval=100, group=G_ENTRY, tooltip="Maximum number of 1-minute bars to wait for price to pull back to the limit entry before canceling.")

// Visual settings matching TradingView reference
showZones         = input.bool(true, "Draw Entry Area Rectangle (FVG / Zone)", group=G_VIS)
showPositionTool  = input.bool(true, "Draw Long/Short Position Tool", group=G_VIS)
showBosLine       = input.bool(true, "Draw BOS Horizontal Line (1x thick)", group=G_VIS)
showP4hLine       = input.bool(true, "Draw Previous 4H Close Line (2x thick)", group=G_VIS)
showDashboard     = input.bool(true, "Show Status Dashboard", group=G_VIS)
posWidth          = input.int(10, "Position Tool Width (Bars)", minval=4, maxval=30, group=G_VIS, tooltip="Width of the Position Tool on chart to keep it clean and neat.")

// Visual Colors
colorTargetBox    = input.color(color.new(#2196F3, 75), "Target Box (Sky Blue)", group=G_VIS)
colorStopBox      = input.color(color.new(#787B86, 75), "Stop Loss Box (Slate Grey)", group=G_VIS)
colorBullEntry    = input.color(#26A69A, "Bullish Entry Line (Green)", group=G_VIS)
colorBearEntry    = input.color(#EF5350, "Bearish Entry Line (Red)", group=G_VIS)
colorDemand       = input.color(color.new(color.blue, 75), "Demand Zone Color", group=G_VIS)
colorSupply       = input.color(color.new(color.maroon, 75), "Supply Zone Color", group=G_VIS)
colorFvg          = input.color(color.new(color.orange, 70), "FVG Box Color", group=G_VIS)

// ==========================================
// 2. DAILY CIRCUIT BREAKER & 4H BIAS
// ==========================================
// Detect start of a new trading day for circuit breaker reset
isNewDay = ta.change(time("D")) != 0

// Detect start of a new 4H period for circuit breaker reset
isNew4H = ta.change(time(htfTimeframe)) != 0

// Loss tracking
var int dailyConsecLosses = 0
var int htfConsecLosses   = 0
var int lastCheckedTrade  = 0

// Reset counters on new sessions
var int dailyTradesCount = 0
if isNewDay
    dailyConsecLosses := 0
    dailyTradesCount  := 0

if isNew4H
    htfConsecLosses   := 0

// Check closed trades as they complete
if strategy.closedtrades > lastCheckedTrade
    for i = lastCheckedTrade to strategy.closedtrades - 1
        float pnl = strategy.closedtrades.profit(i)
        if pnl < 0
            dailyConsecLosses += 1
            htfConsecLosses   += 1
        else if pnl > 0
            dailyConsecLosses := 0 // Reset streak on a winning trade
            htfConsecLosses   := 0
    lastCheckedTrade := strategy.closedtrades

bool isDailyHalted = (maxConsecLossDay > 0) and (dailyConsecLosses >= maxConsecLossDay)
bool is4hHalted    = (maxConsecLoss4H > 0) and (htfConsecLosses >= maxConsecLoss4H)
bool isHalted      = isDailyHalted or is4hHalted
bool canTakeTrade  = (not onlyOneTrade or (strategy.position_size == 0 and not setupPending)) and (maxTradesPerDay == 0 or dailyTradesCount < maxTradesPerDay) and not isHalted

// Fetch Previous 4-Hour Close (P4HC) without repainting
p4hClose = request.security(syminfo.tickerid, htfTimeframe, close[1], barmerge.gaps_off, barmerge.lookahead_off)

// Detect start of a new 4H period
isNew4H = ta.change(time(htfTimeframe)) != 0

// Draw / extend the Previous 4H Close line across the current 4H window (2x thick Black line)
var line p4hLine = na
if showP4hLine
    if isNew4H
        p4hLine := line.new(bar_index, p4hClose, bar_index, p4hClose, color=p4hColor, width=2, style=line.style_solid)
    else if not na(p4hLine)
        line.set_x2(p4hLine, bar_index)

// Directional bias filter based on 4H close
isBullishBias = not useHtfFilter or na(p4hClose) or (close > p4hClose)
isBearishBias = not useHtfFilter or na(p4hClose) or (close < p4hClose)

// ATR minimum zone thickness buffer (prevents micro-pipette sizing errors on 1M Forex/Indices)
atr14 = ta.atr(14)
minAllowedDist = math.max(syminfo.mintick * 5, atr14 * 0.15)

// ==========================================
// 3. 1M INTERNAL SWING STRUCTURE & BOS
// ==========================================
// Identify internal swing points on 1M chart
pHi = ta.pivothigh(high, pivotLookback, pivotLookback)
pLo = ta.pivotlow(low, pivotLookback, pivotLookback)

var float lastSwingHigh    = na
var int   lastSwingHighBar = na
var float lastSwingLow     = na
var int   lastSwingLowBar  = na

if not na(pHi)
    lastSwingHigh    := pHi
    lastSwingHighBar := bar_index - pivotLookback

if not na(pLo)
    lastSwingLow     := pLo
    lastSwingLowBar  := bar_index - pivotLookback

// Bullish BOS Condition on 1M:
bool bullishBOS = false
var int   bullOriginBar  = na
var float bullOriginHigh = na
var float bullOriginLow  = na

if not isDailyHalted and not na(lastSwingHigh) and ta.crossover(close, lastSwingHigh) and isBullishBias
    int lowestBarOffset = 1
    float lowestVal = low[1]
    int searchLen = math.min(30, bar_index - nz(lastSwingHighBar, bar_index - 1))
    if searchLen > 0
        for i = 1 to searchLen
            if low[i] < lowestVal
                lowestVal := low[i]
                lowestBarOffset := i
    
    bool wickConfirmed = not confirmCloseWick or (close > high[lowestBarOffset])
    if wickConfirmed
        bullishBOS     := true
        bullOriginBar  := bar_index - lowestBarOffset
        bullOriginHigh := high[lowestBarOffset]
        bullOriginLow  := low[lowestBarOffset]
        if showBosLine
            line.new(lastSwingHighBar, lastSwingHigh, bar_index, lastSwingHigh, color=bosColor, width=1, style=line.style_solid)

// Bearish BOS Condition on 1M:
bool bearishBOS = false
var int   bearOriginBar  = na
var float bearOriginHigh = na
var float bearOriginLow  = na

if not isDailyHalted and not na(lastSwingLow) and ta.crossunder(close, lastSwingLow) and isBearishBias
    int highestBarOffset = 1
    float highestVal = high[1]
    int searchLen = math.min(30, bar_index - nz(lastSwingLowBar, bar_index - 1))
    if searchLen > 0
        for i = 1 to searchLen
            if high[i] > highestVal
                highestVal := high[i]
                highestBarOffset := i
    
    bool wickConfirmed = not confirmCloseWick or (close < low[highestBarOffset])
    if wickConfirmed
        bearishBOS     := true
        bearOriginBar  := bar_index - highestBarOffset
        bearOriginHigh := high[highestBarOffset]
        bearOriginLow  := low[highestBarOffset]
        if showBosLine
            line.new(lastSwingLowBar, lastSwingLow, bar_index, lastSwingLow, color=bosColor, width=1, style=line.style_solid)

// ==========================================
// 4. FVG IDENTIFICATION & PENDING SETUP (1M)
// ==========================================
var bool  setupPending   = false
var int   setupDir       = 0 // +1 for Long, -1 for Short
var float setupEntry     = na
var float setupSL        = na
var int   setupBar       = na
var float setupRiskDist  = na

// Cancel pending setup if circuit breaker limit hit
if isHalted and setupPending
    setupPending := false
    strategy.cancel_all()

// Register Bullish Setup on confirmed Bullish BOS
if bullishBOS and canTakeTrade
    bool hasFvg = false
    float fvgEntryPrice = na
    float fvgSlPrice = na
    
    if useFvgRefine
        for k = 0 to 3
            if (low[k] > high[k + 2])
                hasFvg := true
                fvgEntryPrice := low[k]
                fvgSlPrice := high[k + 2]
                break
    
    setupPending := true
    setupDir     := 1
    setupBar     := bar_index
    
    if hasFvg
        setupEntry := fvgEntryPrice
        setupSL    := fvgSlPrice
        if showZones
            box.new(bar_index - 3, fvgEntryPrice, bar_index + posWidth, fvgSlPrice, bgcolor=colorFvg, border_color=color.orange, border_width=1)
    else
        setupEntry := bullOriginHigh
        setupSL    := bullOriginLow
        if showZones
            box.new(bullOriginBar, bullOriginHigh, bar_index + posWidth, bullOriginLow, bgcolor=colorDemand, border_color=color.blue, border_width=1)
    
    float rawDist = math.abs(setupEntry - setupSL)
    setupRiskDist := math.max(rawDist, minAllowedDist)
    setupSL       := setupEntry - setupRiskDist
    
    if setupSL >= setupEntry or setupRiskDist <= 0
        setupPending := false
    else if showPositionTool
        // Draw the compact Long Position Tool exactly like TradingView drawing tool
        float tpLevel = setupEntry + (tp_R * setupRiskDist)
        box.new(bar_index, tpLevel, bar_index + posWidth, setupEntry, bgcolor=colorTargetBox, border_color=color.new(#2196F3, 30), border_width=1)
        box.new(bar_index, setupEntry, bar_index + posWidth, setupSL, bgcolor=colorStopBox, border_color=color.new(#787B86, 30), border_width=1)
        line.new(bar_index, setupEntry, bar_index + posWidth, setupEntry, color=colorBullEntry, width=2, style=line.style_solid)

// Register Bearish Setup on confirmed Bearish BOS
if bearishBOS and canTakeTrade
    bool hasFvg = false
    float fvgEntryPrice = na
    float fvgSlPrice = na
    
    if useFvgRefine
        for k = 0 to 3
            if (high[k] < low[k + 2])
                hasFvg := true
                fvgEntryPrice := high[k]
                fvgSlPrice := low[k + 2]
                break
    
    setupPending := true
    setupDir     := -1
    setupBar     := bar_index
    
    if hasFvg
        setupEntry := fvgEntryPrice
        setupSL    := fvgSlPrice
        if showZones
            box.new(bar_index - 3, fvgSlPrice, bar_index + posWidth, fvgEntryPrice, bgcolor=colorFvg, border_color=color.orange, border_width=1)
    else
        setupEntry := bearOriginLow
        setupSL    := bearOriginHigh
        if showZones
            box.new(bearOriginBar, bearOriginHigh, bar_index + posWidth, bearOriginLow, bgcolor=colorSupply, border_color=color.red, border_width=1)
            
    float rawDist = math.abs(setupSL - setupEntry)
    setupRiskDist := math.max(rawDist, minAllowedDist)
    setupSL       := setupEntry + setupRiskDist
    
    if setupSL <= setupEntry or setupRiskDist <= 0
        setupPending := false
    else if showPositionTool
        // Draw the compact Short Position Tool exactly like TradingView drawing tool
        float tpLevel = setupEntry - (tp_R * setupRiskDist)
        box.new(bar_index, setupEntry, bar_index + posWidth, tpLevel, bgcolor=colorTargetBox, border_color=color.new(#2196F3, 30), border_width=1)
        box.new(bar_index, setupSL, bar_index + posWidth, setupEntry, bgcolor=colorStopBox, border_color=color.new(#787B86, 30), border_width=1)
        line.new(bar_index, setupEntry, bar_index + posWidth, setupEntry, color=colorBearEntry, width=2, style=line.style_solid)

// ==========================================
// 5. UNIVERSAL POSITION SIZING & EXECUTION ($10 FIXED RISK OR 1%)
// ==========================================
float pointVal   = (na(syminfo.pointvalue) or syminfo.pointvalue <= 0) ? 1.0 : syminfo.pointvalue
float riskAmount = useFixedUsd ? riskUsd : (strategy.equity * (riskPercent / 100.0))
float rawQty     = (setupRiskDist > 0) ? (riskAmount / (setupRiskDist * pointVal)) : 0.0

// Safe leverage cap (prevents micro-pip sizes from exceeding margin on 1M volatile moves)
float maxSafeUnits = (strategy.equity * 100.0) / (setupEntry > 0 ? setupEntry : close)
float safeQty = math.min(rawQty, maxSafeUnits)

// Adapt order quantity step for Forex vs Gold/Crypto/Stocks
float calcQty = safeQty
if syminfo.type == "forex"
    calcQty := math.max(100.0, math.round(safeQty / 100.0) * 100.0)
else if syminfo.type == "stock" or syminfo.type == "index" or syminfo.type == "futures"
    calcQty := math.max(1.0, math.floor(safeQty))
else
    calcQty := math.max(0.01, math.round_to_mintick(safeQty))

if calcQty <= 0
    setupPending := false

if setupPending and (!onlyOneTrade or strategy.position_size == 0) and not isHalted and (maxTradesPerDay == 0 or dailyTradesCount < maxTradesPerDay)
    // Invalidation 1: Exceeded max waiting bars without fill
    if (bar_index - setupBar) > maxBarsWait
        setupPending := false
    // Invalidation 2: Setup violated against the bias / gap past SL
    else if setupDir == 1
        if low <= setupSL
            setupPending := false
        else
            strategy.entry("Long", strategy.long, qty=calcQty, limit=setupEntry)
    else if setupDir == -1
        if high >= setupSL
            setupPending := false
        else
            strategy.entry("Short", strategy.short, qty=calcQty, limit=setupEntry)

if strategy.position_size != 0 and onlyOneTrade
    setupPending := false

// ==========================================
// 6. STEPPED TRADE MANAGEMENT (9.5R -> 10R TP)
// ==========================================
var float entryPrice = na
var float tradeRisk  = na
var float activeSL   = na
var float maxR       = 0.0

// When trade enters
if ta.change(strategy.position_size) != 0 and strategy.position_size != 0
    dailyTradesCount += 1
    entryPrice := strategy.position_avg_price
    tradeRisk  := setupRiskDist > 0 ? setupRiskDist : math.abs(entryPrice - (setupSL > 0 ? setupSL : close * 0.99))
    activeSL   := strategy.position_size > 0 ? (entryPrice - tradeRisk) : (entryPrice + tradeRisk)
    maxR       := 0.0

// Active Trade Tracking and Stepped Trailing
if strategy.position_size > 0 // LONG
    float currentR = (high - entryPrice) / tradeRisk
    maxR := math.max(maxR, currentR)
    
    // Stepped Stop Loss Management:
    // +9.9R -> Lock +9.0R
    // +9.8R -> Lock +8.0R
    // +9.7R -> Lock +7.0R
    // +9.6R -> Lock +6.0R
    // +9.5R -> Lock +5.0R
    if enableStepped and maxR >= 9.9
        activeSL := math.max(activeSL, entryPrice + (9.0 * tradeRisk))
    else if enableStepped and maxR >= 9.8
        activeSL := math.max(activeSL, entryPrice + (8.0 * tradeRisk))
    else if enableStepped and maxR >= 9.7
        activeSL := math.max(activeSL, entryPrice + (7.0 * tradeRisk))
    else if enableStepped and maxR >= 9.6
        activeSL := math.max(activeSL, entryPrice + (6.0 * tradeRisk))
    else if enableStepped and maxR >= 9.5
        activeSL := math.max(activeSL, entryPrice + (5.0 * tradeRisk))
        
    float tpPrice = entryPrice + (tp_R * tradeRisk)
    strategy.exit("Exit Long", "Long", stop=activeSL, limit=tpPrice)

else if strategy.position_size < 0 // SHORT
    float currentR = (entryPrice - low) / tradeRisk
    maxR := math.max(maxR, currentR)
    
    if enableStepped and maxR >= 9.9
        activeSL := math.min(activeSL, entryPrice - (9.0 * tradeRisk))
    else if enableStepped and maxR >= 9.8
        activeSL := math.min(activeSL, entryPrice - (8.0 * tradeRisk))
    else if enableStepped and maxR >= 9.7
        activeSL := math.min(activeSL, entryPrice - (7.0 * tradeRisk))
    else if enableStepped and maxR >= 9.6
        activeSL := math.min(activeSL, entryPrice - (6.0 * tradeRisk))
    else if enableStepped and maxR >= 9.5
        activeSL := math.min(activeSL, entryPrice - (5.0 * tradeRisk))
        
    float tpPrice = entryPrice - (tp_R * tradeRisk)
    strategy.exit("Exit Short", "Short", stop=activeSL, limit=tpPrice)

// Reset state on trade close
if strategy.position_size == 0
    activeSL   := na
    entryPrice := na
    maxR       := 0.0

// Plot Active SL and Entry
plot(strategy.position_size != 0 ? activeSL : na, "Active Stop Loss", color=color.red, style=plot.style_linebr, linewidth=2)
plot(strategy.position_size != 0 ? entryPrice : na, "Entry Price", color=color.gray, style=plot.style_linebr, linewidth=1)

// ==========================================
// 7. DASHBOARD DISPLAY
// ==========================================
var table dash = table.new(position.top_right, 2, 8, bgcolor=color.new(color.black, 20), border_color=color.gray, border_width=1)
if showDashboard and barstate.islast
    string biasText  = close > p4hClose ? "BULLISH (Longs Only)" : "BEARISH (Shorts Only)"
    color  biasCol   = close > p4hClose ? color.green : color.red
    string brokerStr = syminfo.prefix != "" ? syminfo.prefix : "Standard"
    
    table.cell(dash, 0, 0, "Market / Broker", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 0, syminfo.ticker + " [" + brokerStr + "]", text_color=color.aqua, text_size=size.small)
    
    table.cell(dash, 0, 1, "Timeframe Setup", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 1, "1M Exec / 4H Bias", text_color=color.white, text_size=size.small)
    
    table.cell(dash, 0, 2, "Account Equity", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 2, "$" + str.tostring(strategy.equity, "#.##"), text_color=color.yellow, text_size=size.small)
    
    table.cell(dash, 0, 3, "4H Bias Filter", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 3, biasText, text_color=biasCol, text_size=size.small)
    
    table.cell(dash, 0, 4, "Prev 4H Close (P4HC)", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 4, str.tostring(p4hClose, "#.##"), text_color=color.white, text_size=size.small)
    
    table.cell(dash, 0, 5, "Current Position", text_color=color.white, text_size=size.small)
    string posText = strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT"
    table.cell(dash, 1, 5, posText, text_color=strategy.position_size != 0 ? color.orange : color.gray, text_size=size.small)
    
    table.cell(dash, 0, 6, "Max R Reached", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 6, str.tostring(maxR, "#.##") + "R", text_color=color.aqua, text_size=size.small)
    
    table.cell(dash, 0, 7, "Circuit Breakers", text_color=color.white, text_size=size.small)
    string haltText = isDailyHalted ? "HALTED (Daily 3 Losses)" : is4hHalted ? "HALTED (4H 3 Losses)" : "ACTIVE (" + str.tostring(dailyConsecLosses) + "/3 Day, " + str.tostring(htfConsecLosses) + "/3 4H)"
    color haltCol   = isHalted ? color.red : color.green
    table.cell(dash, 1, 7, haltText, text_color=haltCol, text_size=size.small)
