//@version=5
strategy("PDC 5M BOS + FVG Strategy", overlay=true, initial_capital=1000, default_qty_type=strategy.cash, default_qty_value=10, currency=currency.USD, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ==========================================
// 1. INPUT SETTINGS
// ==========================================
var string G_RISK  = "Risk and Position Sizing"
var string G_BIAS  = "Daily Bias and Timeframe"
var string G_BOS   = "Market Structure / BOS"
var string G_ENTRY = "Zone and Entry Refinement"
var string G_VIS   = "Visuals and Display"

// Risk settings ($1,000 Account, $10 Risk per trade)
riskUsd           = input.float(10.0, "Risk per Trade ($)", group=G_RISK, tooltip="Exact dollar amount to risk per trade. Position size is calculated automatically based on the stop loss distance.")
tp_R              = input.float(10.0, "Final Take Profit (R)", group=G_RISK, tooltip="Target R:R multiple for full take profit.")
enableStepped     = input.bool(true, "Enable Stepped Trailing (9.5R - 9.9R)", group=G_RISK)
maxConsecLossDay  = input.int(3, "Max Consecutive Losses Per Day", minval=1, maxval=10, group=G_RISK, tooltip="If the strategy encounters this many losses in a row within the same day, trading is paused until the next day.")

// Bias settings
usePdcFilter      = input.bool(true, "Filter Trades by Previous Day Close", group=G_BIAS)
pdcColor          = input.color(color.black, "Previous Day Close Line Color", group=G_BIAS)

// BOS settings
pivotLookback     = input.int(3, "Internal Pivot Lookback", minval=1, maxval=20, group=G_BOS, tooltip="Bars left and right to detect internal swing highs/lows on the 5M chart.")
confirmCloseWick  = input.bool(true, "BOS Candle Close Beyond Initiating Wick", group=G_BOS, tooltip="Requires BOS candle close beyond the initiating candle extreme.")

// Entry and Zone settings
useFvgRefine      = input.bool(true, "Use FVG Entry Refinement", group=G_ENTRY, tooltip="If an FVG forms after the origin candle, refine entry to the FVG edge.")
maxBarsWait       = input.int(25, "Max Bars to Wait for Retracement", minval=1, maxval=100, group=G_ENTRY)

// Visual settings
showZones         = input.bool(true, "Draw Demand/Supply and FVG Boxes", group=G_VIS)
showPdcLine       = input.bool(true, "Draw Previous Day Close Line", group=G_VIS)
showDashboard     = input.bool(true, "Show Status Dashboard", group=G_VIS)
colorDemand       = input.color(color.new(color.blue, 75), "Demand Zone Color", group=G_VIS)
colorSupply       = input.color(color.new(color.maroon, 75), "Supply Zone Color", group=G_VIS)
colorFvg          = input.color(color.new(color.orange, 70), "FVG Box Color", group=G_VIS)

// ==========================================
// 2. DAILY SESSION & CONSECUTIVE LOSS CIRCUIT BREAKER
// ==========================================
// Detect start of a new trading day
isNewDay = ta.change(time("D")) != 0

// Daily loss tracking
var int dailyConsecLosses = 0
var int lastCheckedTrade = 0

// Reset daily streak counter on every new day
if isNewDay
    dailyConsecLosses := 0

// Check closed trades as they complete
if strategy.closedtrades > lastCheckedTrade
    for i = lastCheckedTrade to strategy.closedtrades - 1
        float pnl = strategy.closedtrades.profit(i)
        if pnl < 0
            dailyConsecLosses += 1
        else if pnl > 0
            dailyConsecLosses := 0 // Reset streak on a winning trade
    lastCheckedTrade := strategy.closedtrades

bool isDailyHalted = (dailyConsecLosses >= maxConsecLossDay)

// Fetch previous day close (daily close of 1 day ago)
pdc = request.security(syminfo.tickerid, "D", close[1], barmerge.gaps_off, barmerge.lookahead_on)

// Draw / extend the PDC line across the current day
var line pdcLine = na
if showPdcLine
    if isNewDay
        pdcLine := line.new(bar_index, pdc, bar_index, pdc, color=pdcColor, width=2, style=line.style_solid)
    else if not na(pdcLine)
        line.set_x2(pdcLine, bar_index)

// Directional bias filter
isBullishBias = not usePdcFilter or (close > pdc)
isBearishBias = not usePdcFilter or (close < pdc)

// ==========================================
// 3. 5M INTERNAL SWING STRUCTURE & BOS
// ==========================================
// Identify internal swing points
pHi = ta.pivothigh(high, pivotLookback, pivotLookback)
pLo = ta.pivotlow(low, pivotLookback, pivotLookback)

var float lastSwingHigh = na
var int   lastSwingHighBar = na
var float lastSwingLow = na
var int   lastSwingLowBar = na

if not na(pHi)
    lastSwingHigh := pHi
    lastSwingHighBar := bar_index - pivotLookback

if not na(pLo)
    lastSwingLow := pLo
    lastSwingLowBar := bar_index - pivotLookback

// Bullish BOS Condition:
// - Close crosses above recent internal swing high
// - Current price is above PDC (Bullish bias)
// - BOS candle closes above the initiating candle's high/wick
// - Daily circuit breaker is NOT active
bool bullishBOS = false
var int bullOriginBar = na
var float bullOriginHigh = na
var float bullOriginLow = na

if not isDailyHalted and not na(lastSwingHigh) and ta.crossover(close, lastSwingHigh) and isBullishBias
    int lowestBarOffset = 1
    float lowestVal = low[1]
    int searchLen = math.min(30, bar_index - nz(lastSwingHighBar, bar_index - 1))
    if searchLen > 0
        for i = 1 to searchLen
            if low[i] < lowestVal
                lowestVal := low[i]
                lowestBarOffset := i
    
    bool wickConfirmed = not confirmCloseWick or (close > high[lowestBarOffset])
    if wickConfirmed
        bullishBOS := true
        bullOriginBar := bar_index - lowestBarOffset
        bullOriginHigh := high[lowestBarOffset]
        bullOriginLow := low[lowestBarOffset]

// Bearish BOS Condition:
// - Close crosses below recent internal swing low
// - Current price is below PDC (Bearish bias)
// - BOS candle closes below the initiating candle's low/wick
// - Daily circuit breaker is NOT active
bool bearishBOS = false
var int bearOriginBar = na
var float bearOriginHigh = na
var float bearOriginLow = na

if not isDailyHalted and not na(lastSwingLow) and ta.crossunder(close, lastSwingLow) and isBearishBias
    int highestBarOffset = 1
    float highestVal = high[1]
    int searchLen = math.min(30, bar_index - nz(lastSwingLowBar, bar_index - 1))
    if searchLen > 0
        for i = 1 to searchLen
            if high[i] > highestVal
                highestVal := high[i]
                highestBarOffset := i
    
    bool wickConfirmed = not confirmCloseWick or (close < low[highestBarOffset])
    if wickConfirmed
        bearishBOS := true
        bearOriginBar := bar_index - highestBarOffset
        bearOriginHigh := high[highestBarOffset]
        bearOriginLow := low[highestBarOffset]

// ==========================================
// 4. FVG IDENTIFICATION & PENDING SETUP
// ==========================================
var bool  setupPending   = false
var int   setupDir       = 0 // +1 for Long, -1 for Short
var float setupEntry     = na
var float setupSL        = na
var int   setupBar       = na
var float setupRiskDist  = na
var box   setupZoneBox   = na
var box   setupFvgBox    = na

// Cancel pending setup if daily limit hit
if isDailyHalted and setupPending
    setupPending := false
    strategy.cancel_all()

// Register Bullish Setup on confirmed Bullish BOS
if bullishBOS and strategy.position_size == 0 and not isDailyHalted
    bool hasFvg = false
    float fvgEntryPrice = na
    float fvgSlPrice = na
    
    if useFvgRefine
        for k = 0 to 3
            if (low[k] > high[k + 2])
                hasFvg := true
                fvgEntryPrice := low[k]
                fvgSlPrice := high[k + 2]
                break
    
    setupPending := true
    setupDir := 1
    setupBar := bar_index
    
    if hasFvg
        setupEntry := fvgEntryPrice
        setupSL := fvgSlPrice
        if showZones
            setupFvgBox := box.new(bar_index - 3, fvgEntryPrice, bar_index + 12, fvgSlPrice, bgcolor=colorFvg, border_color=color.orange)
    else
        setupEntry := bullOriginHigh
        setupSL := bullOriginLow
        if showZones
            setupZoneBox := box.new(bullOriginBar, bullOriginHigh, bar_index + 12, bullOriginLow, bgcolor=colorDemand, border_color=color.blue)
    
    setupRiskDist := math.abs(setupEntry - setupSL)
    if setupSL >= setupEntry or setupRiskDist <= 0
        setupPending := false

// Register Bearish Setup on confirmed Bearish BOS
if bearishBOS and strategy.position_size == 0 and not isDailyHalted
    bool hasFvg = false
    float fvgEntryPrice = na
    float fvgSlPrice = na
    
    if useFvgRefine
        for k = 0 to 3
            if (high[k] < low[k + 2])
                hasFvg := true
                fvgEntryPrice := high[k]
                fvgSlPrice := low[k + 2]
                break
    
    setupPending := true
    setupDir := -1
    setupBar := bar_index
    
    if hasFvg
        setupEntry := fvgEntryPrice
        setupSL := fvgSlPrice
        if showZones
            setupFvgBox := box.new(bar_index - 3, fvgSlPrice, bar_index + 12, fvgEntryPrice, bgcolor=colorFvg, border_color=color.orange)
    else
        setupEntry := bearOriginLow
        setupSL := bearOriginHigh
        if showZones
            setupZoneBox := box.new(bearOriginBar, bearOriginHigh, bar_index + 12, bearOriginLow, bgcolor=colorSupply, border_color=color.red)
            
    setupRiskDist := math.abs(setupSL - setupEntry)
    if setupSL <= setupEntry or setupRiskDist <= 0
        setupPending := false

// ==========================================
// 5. POSITION SIZING ($10 FIXED RISK) & EXECUTION
// ==========================================
// Dynamic position sizing formula:
// Qty = Risk ($10) / (Risk Distance * Point Value)
float pointVal = syminfo.pointvalue > 0 ? syminfo.pointvalue : 1.0
float calcQty = (setupRiskDist > 0) ? (riskUsd / (setupRiskDist * pointVal)) : 0.0

if setupPending and strategy.position_size == 0 and not isDailyHalted
    // Invalidation 1: Exceeded max waiting bars without fill
    if (bar_index - setupBar) > maxBarsWait
        setupPending := false
    // Invalidation 2: Setup violated against the bias / gap past SL
    else if setupDir == 1
        if low <= setupSL
            setupPending := false
        else
            strategy.entry("Long", strategy.long, qty=calcQty, limit=setupEntry)
    else if setupDir == -1
        if high >= setupSL
            setupPending := false
        else
            strategy.entry("Short", strategy.short, qty=calcQty, limit=setupEntry)

if strategy.position_size != 0
    setupPending := false

// ==========================================
// 6. STEPPED TRADE MANAGEMENT (9.5R -> 10R TP)
// ==========================================
var float entryPrice = na
var float tradeRisk  = na
var float activeSL   = na
var float maxR       = 0.0

// When trade enters
if ta.change(strategy.position_size) != 0 and strategy.position_size != 0
    entryPrice := strategy.position_avg_price
    tradeRisk  := setupRiskDist > 0 ? setupRiskDist : math.abs(entryPrice - (setupSL > 0 ? setupSL : close * 0.99))
    activeSL   := strategy.position_size > 0 ? (entryPrice - tradeRisk) : (entryPrice + tradeRisk)
    maxR       := 0.0

// Active Trade Tracking and Trailing
if strategy.position_size > 0 // LONG
    float currentR = (high - entryPrice) / tradeRisk
    maxR := math.max(maxR, currentR)
    
    // Stepped Stop Loss Management:
    // +9.9R -> Lock +9.0R
    // +9.8R -> Lock +8.0R
    // +9.7R -> Lock +7.0R
    // +9.6R -> Lock +6.0R
    // +9.5R -> Lock +5.0R
    if enableStepped and maxR >= 9.9
        activeSL := math.max(activeSL, entryPrice + (9.0 * tradeRisk))
    else if enableStepped and maxR >= 9.8
        activeSL := math.max(activeSL, entryPrice + (8.0 * tradeRisk))
    else if enableStepped and maxR >= 9.7
        activeSL := math.max(activeSL, entryPrice + (7.0 * tradeRisk))
    else if enableStepped and maxR >= 9.6
        activeSL := math.max(activeSL, entryPrice + (6.0 * tradeRisk))
    else if enableStepped and maxR >= 9.5
        activeSL := math.max(activeSL, entryPrice + (5.0 * tradeRisk))
        
    float tpPrice = entryPrice + (tp_R * tradeRisk)
    strategy.exit("Exit Long", "Long", stop=activeSL, limit=tpPrice)

else if strategy.position_size < 0 // SHORT
    float currentR = (entryPrice - low) / tradeRisk
    maxR := math.max(maxR, currentR)
    
    if enableStepped and maxR >= 9.9
        activeSL := math.min(activeSL, entryPrice - (9.0 * tradeRisk))
    else if enableStepped and maxR >= 9.8
        activeSL := math.min(activeSL, entryPrice - (8.0 * tradeRisk))
    else if enableStepped and maxR >= 9.7
        activeSL := math.min(activeSL, entryPrice - (7.0 * tradeRisk))
    else if enableStepped and maxR >= 9.6
        activeSL := math.min(activeSL, entryPrice - (6.0 * tradeRisk))
    else if enableStepped and maxR >= 9.5
        activeSL := math.min(activeSL, entryPrice - (5.0 * tradeRisk))
        
    float tpPrice = entryPrice - (tp_R * tradeRisk)
    strategy.exit("Exit Short", "Short", stop=activeSL, limit=tpPrice)

// Reset state on trade close
if strategy.position_size == 0
    activeSL   := na
    entryPrice := na
    maxR       := 0.0

// Plot Active SL and Entry
plot(strategy.position_size != 0 ? activeSL : na, "Active Stop Loss", color=color.red, style=plot.style_linebr, linewidth=2)
plot(strategy.position_size != 0 ? entryPrice : na, "Entry Price", color=color.gray, style=plot.style_linebr, linewidth=1)

// ==========================================
// 7. DASHBOARD DISPLAY
// ==========================================
var table dash = table.new(position.top_right, 2, 7, bgcolor=color.new(color.black, 20), border_color=color.gray, border_width=1)
if showDashboard and barstate.islast
    string biasText = close > pdc ? "BULLISH (Longs Only)" : "BEARISH (Shorts Only)"
    color biasCol   = close > pdc ? color.green : color.red
    
    table.cell(dash, 0, 0, "Account Size", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 0, "$" + str.tostring(strategy.equity, "#.##"), text_color=color.yellow, text_size=size.small)
    
    table.cell(dash, 0, 1, "Risk / Trade", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 1, "$" + str.tostring(riskUsd, "#.##"), text_color=color.white, text_size=size.small)
    
    table.cell(dash, 0, 2, "Daily Bias", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 2, biasText, text_color=biasCol, text_size=size.small)
    
    table.cell(dash, 0, 3, "Prev Day Close", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 3, str.tostring(pdc, "#.##"), text_color=color.white, text_size=size.small)
    
    table.cell(dash, 0, 4, "Current Position", text_color=color.white, text_size=size.small)
    string posText = strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT"
    table.cell(dash, 1, 4, posText, text_color=strategy.position_size != 0 ? color.orange : color.gray, text_size=size.small)
    
    table.cell(dash, 0, 5, "Max R Reached", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 5, str.tostring(maxR, "#.##") + "R", text_color=color.aqua, text_size=size.small)
    
    table.cell(dash, 0, 6, "Daily Status", text_color=color.white, text_size=size.small)
    string haltText = isDailyHalted ? "HALTED (3 Losses)" : "ACTIVE (" + str.tostring(dailyConsecLosses) + "/3 Losses)"
    color haltCol   = isDailyHalted ? color.red : color.green
    table.cell(dash, 1, 6, haltText, text_color=haltCol, text_size=size.small)
